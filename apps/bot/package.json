{
  "name": "@knight/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src --passWithNoTests",
    "build": "tsc -p tsconfig.json",
    "dev": "node --enable-source-maps dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@knight/config": "workspace:*",
    "@knight/contracts": "workspace:*",
    "@knight/database": "workspace:*",
    "@knight/discord": "workspace:*",
    "@knight/redis": "workspace:*",
    "@knight/security": "workspace:*",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
