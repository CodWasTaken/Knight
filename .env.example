# Discord bot token. Never commit a real token.
DISCORD_TOKEN=
# Discord application/client ID.
DISCORD_CLIENT_ID=
# Discord OAuth client secret. Never expose it to the browser.
DISCORD_CLIENT_SECRET=
# Auth.js session secret. Use a long random value (32+ characters).
AUTH_SECRET=
# Public dashboard URL, e.g. https://knight.example.com
APP_URL=http://localhost:3000
# PostgreSQL connection used by bot/web/worker.
DATABASE_URL=postgres://knight:knight@localhost:5432/knight
# Redis connection used for limits, locks, and short-lived correlations.
REDIS_URL=redis://:knight@localhost:6379
# Docker reference deployment passwords.
POSTGRES_PASSWORD=knight
REDIS_PASSWORD=knight
